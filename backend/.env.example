# Backend Configuration

# Server
PORT=3000
NODE_ENV=development

# yt-dlp
# Full path to the binary if it is not on your PATH
# YTDLP_BINARY=C:\path\to\yt-dlp.exe
# JavaScript runtime yt-dlp uses to solve YouTube's player challenges.
# "node" needs Node 20+, "deno" also works once Deno is installed.
YTDLP_JS_RUNTIME=node
# Format sorting for merged downloads (H.264 + AAC -> normal MP4)
# YTDLP_SORT=vcodec:h264,res,aext:m4a
# How long a finished download is kept so Pause/Resume can continue with a
# Range request (milliseconds)
TEMP_FILE_TTL_MS=600000
# Give up if a direct stream produces no data within this many milliseconds
STREAM_STARTUP_TIMEOUT_MS=60000

# Disk Management
MAX_DISK_SPACE_MB=5000

# Rate Limiting
GENERAL_RATE_LIMIT_WINDOW_MS=3600000
GENERAL_RATE_LIMIT_MAX=30
DOWNLOAD_RATE_LIMIT_MAX=10
PLAYLIST_RATE_LIMIT_MAX=5
